{
  "name": "peris",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "prisma", "@prisma/client", "@prisma/engines", "@embedded-postgres/windows-x64"]
  },
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/api run start",
    "typecheck": "npm --prefix apps/web run typecheck"
  }
}
